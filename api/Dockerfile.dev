# Dev container for library-api (Rails --api) on Ruby 3.4.13
# Note: This is a minimal development image; production Dockerfile is generated by Rails.

FROM ruby:3.4.13-slim

# Install system dependencies for building gems and PostgreSQL client
RUN apt-get update -qq \
  && apt-get install --no-install-recommends -y \
    build-essential \
    git \
    libpq-dev \
    postgresql-client \
    curl \
  && rm -rf /var/lib/apt/lists /var/cache/apt/archives

# Set working directory
WORKDIR /app

# Cache bundle installation
ENV BUNDLE_JOBS=4 \
    BUNDLE_RETRY=3 \
    RAILS_ENV=development \
    RACK_ENV=development

# Install gems (first copy Gemfile* for better layer caching)
COPY Gemfile Gemfile.lock ./
RUN bundle install

# Copy the rest of the app
COPY . .

# Use Rails' docker entrypoint to auto db:prepare when starting the server
ENTRYPOINT ["./bin/docker-entrypoint"]

EXPOSE 3000
CMD ["./bin/rails", "server", "-b", "0.0.0.0", "-p", "3000"]
